# ============================================================
# 多模式协同智能问答系统 - 环境配置模板
# 复制为 .env 后填写真实值：  cp .env.example .env
# ============================================================

# ---------- 应用 ----------
APP_NAME=工业软件多模式协同智能问答系统
DEBUG=true
API_PREFIX=/api/v1

# ---------- JWT 认证 ----------
# 生产环境务必改为足够长的随机字符串（可用: python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- MySQL（业务持久化）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=multi_mode_qa

# ---------- Redis（热点缓存 / JWT 黑名单）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- Neo4j（知识图谱）----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456

# ---------- Chroma（向量数据库，本地持久化目录）----------
CHROMA_PATH=./data/chroma

# ---------- 千问大模型（OpenAI 库兼容端点）----------
# 阿里云百炼平台申请: https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_LLM_MODEL=qwen-plus
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ---------- 检索参数 ----------
BM25_TOP_K=10
VECTOR_TOP_K=10
KG_TOP_K=10
FUSION_TOP_K=6
RRF_K=60
FUSION_WEIGHT_BM25=1.0
FUSION_WEIGHT_VECTOR=1.0
FUSION_WEIGHT_KG=1.0

# ---------- 文档处理 ----------
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx

# ---------- 缓存 ----------
REDIS_CACHE_TTL=3600

# ---------- CORS（前端开发服务器地址）----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
